@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Admin/Index.cshtml";
}

<div class="container-fluid pt-4 px-4">
    <div class="row g-4">
        <div class="col-sm-6 col-xl-3">
            <div class="bg-light rounded d-flex align-items-center justify-content-between p-4">
                <i class="fa fa-calculator fa-3x text-primary"></i>
                <div class="ms-3">
                    <p class="mb-2">Ortalama Fiyat</p>
                    <h6 class="mb-0">@Convert.ToDecimal(ViewBag.AveragePrice).ToString("N2") ₺</h6>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="bg-light rounded d-flex align-items-center justify-content-between p-4">
                <i class="fa fa-arrow-up fa-3x text-primary"></i>
                <div class="ms-3">
                    <p class="mb-2">En Pahalı Araç</p>
                    <h6 class="mb-0">@ViewBag.MostExpensiveVehicleName</h6>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="bg-light rounded d-flex align-items-center justify-content-between p-4">
                <i class="fa fa-arrow-down fa-3x text-primary"></i>
                <div class="ms-3">
                    <p class="mb-2">En Ucuz Araç</p>
                    <h6 class="mb-0">@ViewBag.CheapestVehicleName</h6>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="bg-light rounded d-flex align-items-center justify-content-between p-4">
                <i class="fa fa-arrows-alt-v fa-3x text-primary"></i>
                <div class="ms-3">
                    <p class="mb-2">Fiyat Makası</p>
                    <h6 class="mb-0">@Convert.ToDecimal(ViewBag.PriceGapBetweenMaxAndMin).ToString("N2") ₺</h6>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="container-fluid pt-4 px-4">
    <div class="row g-4">
        <div class="col-sm-6 col-xl-3">
            <div class="bg-light rounded d-flex align-items-center justify-content-between p-4">
                <i class="fa fa-globe fa-3x text-primary"></i>
                <div class="ms-3">
                    <p class="mb-2">Farklı Şehir Sayısı</p>
                    <h6 class="mb-0">@ViewBag.DifferentCityCount</h6>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="bg-light rounded d-flex align-items-center justify-content-between p-4">
                <i class="fa fa-map-marker-alt fa-3x text-primary"></i>
                <div class="ms-3">
                    <p class="mb-2">En Çok Araç Alınan Şehir</p>
                    <h6 class="mb-0">@ViewBag.CityWithMostVehicles</h6>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="bg-light rounded d-flex align-items-center justify-content-between p-4">
                <i class="fa fa-star fa-3x text-primary"></i>
                <div class="ms-3">
                    <p class="mb-2">En Popüler Araç Tipi</p>
                    <h6 class="mb-0">@ViewBag.TopVehicleBrand</h6>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="bg-light rounded d-flex align-items-center justify-content-between p-4">
                <i class="fa fa-hashtag fa-3x text-primary"></i>
                <div class="ms-3">
                    <p class="mb-2">Lider Kategori ID</p>
                    <h6 class="mb-0">@ViewBag.IdOfCategoryWithMostVehicles</h6>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid pt-4 px-4">
    <div class="row g-4">
        <div class="col-sm-6 col-xl-3">
            <div class="bg-light rounded d-flex align-items-center justify-content-between p-4">
                <i class="fa fa-chart-pie fa-3x text-primary"></i>
                <div class="ms-3">
                    <p class="mb-2">Kategori B. Ort. Araç</p>
                    <h6 class="mb-0">@ViewBag.AvgVehicleCountPerCategory</h6>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="bg-light rounded d-flex align-items-center justify-content-between p-4">
                <i class="fa fa-layer-group fa-3x text-primary"></i>
                <div class="ms-3">
                    <p class="mb-2">Ortalama Üstü Araç</p>
                    <h6 class="mb-0">@ViewBag.VehicleCountAboveAveragePrice</h6>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="bg-light rounded d-flex align-items-center justify-content-between p-4">
                <i class="fa fa-clock fa-3x text-primary"></i>
                <div class="ms-3">
                    <p class="mb-2">Son Eklenen Araç</p>
                    <h6 class="mb-0">@ViewBag.LatestVehicle</h6>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="bg-light rounded d-flex align-items-center justify-content-between p-4">
                <i class="fa fa-check-circle fa-3x text-primary"></i>
                <div class="ms-3">
                    <p class="mb-2">Sistem Durumu</p>
                    <h6 class="mb-0">Aktif / Çevrimiçi</h6>
                </div>
            </div>
        </div>
    </div>
</div>