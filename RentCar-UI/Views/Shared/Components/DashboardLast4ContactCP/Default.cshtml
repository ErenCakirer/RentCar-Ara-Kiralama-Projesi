@model List<RentCar_UI.Dtos.ContactDto.Last4ContactResultDto>

<div class="col-sm-12 col-md-6 col-xl-4">
    <div class="h-100 bg-light rounded p-4">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <h6 class="mb-0">Mesajlar</h6>
            <a href="/Admin/Contact/Index">Hepsini Gör</a>
        </div>

        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="d-flex align-items-center border-bottom py-3">
                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center flex-shrink-0" style="width: 40px; height: 40px; font-weight: bold;">
                        @item.Name.Substring(0, 1).ToUpper()
                    </div>
                    <div class="w-100 ms-3">
                        <div class="d-flex w-100 justify-content-between">
                            <h6 class="mb-0">@item.Name</h6>
                            <small class="text-muted">@item.SendDate.ToString("dd.MM.yyyy")</small>
                        </div>
                        <span class="text-truncate d-inline-block" style="max-width: 200px; font-size: 14px; color: #6c757d;">
                            <strong>@item.Subject:</strong> @item.Message
                        </span>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="py-3 text-center">
                <span class="text-muted">Henüz yeni bir mesaj bulunmuyor.</span>
            </div>
        }
    </div>
</div>