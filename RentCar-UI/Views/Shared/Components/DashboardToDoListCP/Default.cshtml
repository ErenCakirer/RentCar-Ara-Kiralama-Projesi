@model List<RentCar_UI.Dtos.ToDoListDto.ResultToDoListDto>

<div class="col-sm-12 col-md-6 col-xl-4">
    <div class="h-100 bg-light rounded p-4">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <h6 class="mb-0">Yapılacaklar Listesi</h6>
            <a href="">Hepsini Gör</a>
        </div>
        <div class="d-flex mb-2">
            <input class="form-control bg-transparent" type="text" placeholder="Görev girin...">
            <button type="button" class="btn btn-primary ms-2">Ekle</button>
        </div>

        @if (Model != null && Model.Any())
        {
            @for (int i = 0; i < Model.Count; i++)
            {
                var item = Model[i];
                bool isLast = (i == Model.Count - 1);
                string spacingClass = isLast ? "pt-2" : "border-bottom py-2";

                <div class="d-flex align-items-center @spacingClass">
                    <input class="form-check-input m-0" type="checkbox" @(item.Status ? "checked" : "")>
                    <div class="w-100 ms-3">
                        <div class="d-flex w-100 align-items-center justify-content-between">
                            @if (item.Status)
                            {
                                <span><del>@item.Description</del></span>
                                <button class="btn btn-sm text-primary"><i class="fa fa-times"></i></button>
                            }
                            else
                            {
                                <span>@item.Description</span>
                                <button class="btn btn-sm"><i class="fa fa-times"></i></button>
                            }
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="py-3 text-center text-muted">
                <span>Henüz bir görev planlanmadı.</span>
            </div>
        }
    </div>
</div>