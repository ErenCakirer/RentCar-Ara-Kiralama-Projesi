@model RentCar_UI.Dtos.VehicleDtos.GetVehicleDetailDto
@{
    ViewData["Title"] = "Araç Detayı";
    Layout = "~/Views/Shared/DefaultLayout.cshtml";
}

<div class="container py-5" style="margin-top: 100px;">
    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-0 p-3" style="background: #f8f9fa;">
                <img src="@Model.coverImage" class="img-fluid rounded" alt="@Model.title" style="width: 100%; max-height: 400px; object-fit: contain;" />
            </div>
        </div>
        <div class="col-md-6">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="font-weight-bold" style="margin: 0;">@Model.title</h2>
                <span class="badge badge-success p-2" style="font-size: 16px;">Aktif İlan</span>
            </div>

            <h3 class="text-danger font-weight-bold mb-4">
                @Model.price.ToString("N0") ₺ <span style="font-size: 16px; color: #6c757d; font-weight: normal;">/ Günlük</span>
            </h3>

            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body p-4">
                    <h5 class="font-weight-bold mb-3"><i class="fa fa-car text-primary mr-2"></i>Teknik Özellikler</h5>
                    <table class="table table-hover table-striped mb-0">
                        <tbody>
                            <tr>
                                <td><strong>Model Yılı:</strong></td>
                                <td>@Model.modelYear</td>
                            </tr>
                            <tr>
                                <td><strong>Yakıt Türü:</strong></td>
                                <td>@Model.FuelType</td>
                            </tr>
                            <tr>
                                <td><strong>Vites Tipi:</strong></td>
                                <td>@Model.Transmission</td>
                            </tr>
                            <tr>
                                <td><strong>Kilometre:</strong></td>
                                <td>@Model.kilometer.ToString("N0") KM</td>
                            </tr>
                            <tr>
                                <td><strong>Vites Sayısı:</strong></td>
                                <td>@Model.gearCount İleri</td>
                            </tr>
                            <tr>
                                <td><strong>Koltuk Sayısı:</strong></td>
                                <td>@Model.seatCount Kişilik</td>
                            </tr>
                            <tr>
                                <td><strong>Motor Hacmi:</strong></td>
                                <td>@Model.engineSize cc</td>
                            </tr>
                            <tr>
                                <td><strong>Konum:</strong></td>
                                <td>@Model.city, @Model.district</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <a href="/Vehicle/Index" class="btn btn-outline-secondary btn-block font-weight-bold py-2"><i class="fa fa-arrow-left mr-2"></i>Filoya Dön</a>
        </div>
    </div>
</div>